# KYLAB 后端环境变量模板
#
# 用法：复制本文件为 backend/.env（可选）。.env 已被 .gitignore 忽略，
# 任何 token / API key 禁止提交（工程规范 §6）。
#
# 这里只放**引导级**配置：连不上就起不来的东西（数据库连接串、对象存储凭据、
# 数据目录）。它们只能来自环境变量——"把数据库连接串存进数据库"是鸡生蛋。
#
# 其余可改的运行期配置一律在网页上配：
#   侧栏底部账号菜单 →「设置」→ 模型注册 / 向量化 / 对话模型 / 服务配置
# 它们落数据库、改完即刻生效、不必重启（架构设计 v0.2 §13），且密钥只回显掩码。
# 所以下面**没有** embedding / LLM 的地址与密钥：那些属于"登记了哪个模型"，
# 由模型注册表承担（v0.8 归属整理）。

# ---- 服务 ----
KYLAB_HOST=127.0.0.1
KYLAB_PORT=8000
KYLAB_LOG_LEVEL=INFO
KYLAB_DATA_DIR=./data
KYLAB_CORS_ORIGINS=http://127.0.0.1:5173
KYLAB_SLOW_QUERY_MS=500

# 内嵌任务消费者。**单容器部署要留着它**，否则上传后没人处理队列。
# 测试里关掉它，改为手动驱动，避免时序不确定。
KYLAB_RUN_WORKER=true
# 任务租约时长（秒）：worker 执行期间按 1/3 周期续租，崩溃后由超时回收兜底。
KYLAB_WORKER_LEASE_SECONDS=60
# 同一进程里的消费者个数（1–8，默认 1）。
#
# 摄入的绝大部分时间在**等远端**（云端解析轮询、embedding、出题），单消费者时这些
# 等待会串行：实测一篇文档的分段出题有 51 批、每批 1~2 分钟，它一个人就能把后面
# 30 篇排队文档堵死。加到 2~4 能把等待重叠起来。
# 代价是 CPU 与内存（切词、向量化都在进程内），且消费者共享连接池（默认池上限 10），
# 所以上限 8；要更高得先抬池子。任务中心顶部的负载面板会显示"在跑 / 上限"。
KYLAB_WORKER_CONCURRENCY=1
# 分段出题同时发几批（默认 4）。出题是摄入链路里最慢的一步，而它是在**等远端**：
# 串行发等于把等待叠起来（实测一份 400 段的文档 = 50 批，每批一次模型调用）。
# 实测并发 4 比串行快 2.6 倍。别开太大，模型的 RPM/TPM 限额是真的。
KYLAB_QUESTIONS_CONCURRENCY=4
# MinerU 每日优先额度的页数（官方口径 1000 页/天）。超了不是报错，是**降级排队**
# ——用户只会看到"卡住不动"，所以负载面板把"今日已用 / 额度"显示出来。
# 这是本地记账（按今日解析过的文档/子文件页数累加），不是向云端查的真实剩余量。
KYLAB_MINERU_DAILY_PAGE_QUOTA=1000

# ---- 存储后端（v0.12：SQLite 退役，改 PostgreSQL + 对象存储）----
#
# 三个存储各管一段（架构设计 v0.2 §8）：
#   PostgreSQL  元数据 + 向量(pgvector) + 全文(tsvector)
#   MinIO/S3    原件、Markdown 产物、图片（内容 hash 寻址）
#   DuckDB      表格型文档的结构化副本（仍是本地文件，随 data_dir）
#
# 装配点只有一处：app/core/storage.py::build_stores()，启动时校验连通性。
#
# **必填**（v0.12：SQLite 已退役，存储只有 PostgreSQL）。留空时服务启动就报错，
# 并告诉你该填什么——不会静默退回别的实现。
# 连接串形如 postgresql://用户:口令@主机:5432/库名
KYLAB_DATABASE_URL=

# 对象存储（S3 兼容）。留空时原件落本地文件系统 data_dir/{originals,markdown,images}。
# MinIO 容器内网地址形如 http://minio:9000；s3_secure 为假表示走 http。
KYLAB_S3_ENDPOINT=
KYLAB_S3_ACCESS_KEY=
KYLAB_S3_SECRET_KEY=
KYLAB_S3_BUCKET=kylab
# MinIO 不校验 region，但 S3 SDK 需要一个非空值
KYLAB_S3_REGION=us-east-1
KYLAB_S3_SECURE=false
# 桶内 key 前缀：一个桶放多套环境时用（如 dev/、prod/），留空即桶根
KYLAB_S3_PREFIX=

# ---- 鉴权（上局域网前必读，架构设计 v0.2 §3.2）----
#
# **鉴权永远生效，没有开关**（v0.11）：第一次打开必须先创建管理员账号
# （POST /auth/setup），之后一律用登录会话或 API Key。管理员身份只能来自
# 会话里的角色——设置页是 embedding / LLM 密钥的落点，且 base_url 可改，
# 外部 API Key 若能碰它就能把你的密钥转发到自己的服务器，所以它一律 403。
#
# 原先的 KYLAB_AUTH_ENABLED 与 KYLAB_CONSOLE_TOKEN 已取消：
# "还没配凭据"与"忘了配凭据"在代码上无法区分，于是"没配就放行"
# 等价于"无账号即裸奔"。
#
# 外部集成的 API Key 不在 .env 里配，而是走接口发（明文只在创建响应出现一次）：
#   POST /api/v1/api-keys  {"name":"给 Grafana 的只读钥匙","permission":"readonly",
#                           "knowledge_base_ids":["kb_xxx"]}
# 调用时带 Authorization: Bearer kylab_sk_...
# permission 为 readonly / readwrite；knowledge_base_ids 留空表示不限制范围。

# 下载签名 URL 的密钥。浏览器里 <img> 与下载链接带不了 Authorization 头，
# 所以"有权访问"要编码进 URL 本身。
# 留空即可：首次 POST /auth/setup 会自动生成一条并落库。
KYLAB_URL_SIGNING_SECRET=

# ---- 可选：部署时预设一次云端解析凭据（留空即可，之后在网页上填）----
#
# MinerU token 有效期 90 天且不可续期，设置页会提示过期（架构设计 v0.2 §12、§15）
KYLAB_MINERU_TOKEN=
KYLAB_PADDLEOCR_TOKEN=

# ---- 行为参数（不是模型身份）----
#
# 模型身份（地址 / 密钥 / 名称 / 维度）在「设置 → 模型注册」里登记，不在环境变量里。
# 这里只有影响调用方式的行为参数。

# 单次 embedding 请求的文本条数。太大可能被端点拒绝。
KYLAB_EMBEDDING_BATCH_SIZE=32

# 嵌入协议：openai（默认）/ wemm。
#
#   openai  OpenAI 兼容端点（云端各家 / 本机 Ollama / vLLM）——默认值，行为与从前一致；
#   wemm    局域网 WeMM-Embedding-2B 多模态（llama.cpp）：**文本走同一个 OpenAI 兼容口**，
#           另有图片/视频那条三步媒体协议（现取 media_marker → base64 → POST /embedding），
#           三种模态共享同一向量空间（一句文字就能搜到图），详见
#           docs/归档/调研/WeMM-Embedding-2B-接入文档-v0.1.md。
# 本机实测的那台服务是本项目的既定部署：http://192.168.31.18:8234（无鉴权、2048 维原生、
# 已 L2 归一化）。**地址不写在这里**——它属于"注册了哪个供应商"，在
# 「设置 → 模型注册」里登记供应商时填；模型填 WeMM-Embedding-2B-Q4_K_M.gguf。
#
# **维度建议填 1024**（有向量索引），不是原生的 2048：
#
#   * 1024 = 接入文档列出的 Matryoshka 档位：客户端取前 1024 维并**重新归一化**
#     （余弦仍等于点积），检索结果正确，而且 pgvector 的 HNSW 索引建得起来；
#   * 2048 = 原生精度（截断会丢一点点），但 **pgvector 的 HNSW 最多 2000 维**，于是
#     2048 的库**没有向量索引**、检索走精确扫描：数据量小时没差别，数据量大时明显变慢。
#     这种情况下系统**不会假装"索引建好了、只是慢"**——建库/首次写入时会把那句话
#     写进日志，并由 `PostgresVectorStore.ensure_partition` 作为返回值交给调用方去显示。
# 一句话：**想要索引就填 ≤2000 的维度**（推荐 1024）；想要原生精度就接受精确检索。
# 这一项只是**引导值**：网页上改过之后以库里为准（与批大小同一条规则）。
KYLAB_EMBEDDING_PROTOCOL=openai

# 开发用确定性嵌入（哈希）开关，**默认关闭，生产不要开**。
# 关闭时"没配嵌入模型"就是真没配：建库被拒、向量通道跳过，界面如实说明。
# 打开它才会退回无语义的词面哈希——只为离线开发与测试留一条不联网的链路。
KYLAB_DEV_EMBEDDING=false

# 对话模型的采样与思考开关
KYLAB_LLM_TEMPERATURE=0.3
# 思考开关默认开：主流模型默认都思考，关掉是例外而不是常态。
# 不同供应商用不同字段表达（DeepSeek 认 thinking.type、Qwen 认 enable_thinking）。
KYLAB_LLM_ENABLE_THINKING=true
# 思考强度：low / medium / high，同样按方言翻译或丢弃
KYLAB_LLM_THINKING_EFFORT=medium
